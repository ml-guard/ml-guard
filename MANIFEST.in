# Files that go into the source distribution (sdist).
#
# pyproject.toml already declares what goes into the wheel via
# [tool.setuptools.package-data]. MANIFEST.in covers sdist, whose
# behavior is slightly different.

include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include pyproject.toml

# Rust sources (for users building from sdist with native extras)
recursive-include rust_engine *.rs *.toml

# Documentation (user-facing and dev)
recursive-include docs *.md *.yml *.txt

# Bundled OSV mini-DB
include ml_guard/data/osv-mini.sqlite
include ml_guard/data/README.md
include ml_guard/py.typed

# Maintainer scripts (sdist only, not in wheel)
recursive-include scripts *.py *.txt

# Tests — for users who want to verify the installed package
recursive-include tests *.py
include run_tests.py

# Benchmarks (optional)
recursive-include benchmarks *.py

# GitHub Actions / CI
recursive-include .github *.yml *.yaml

# What we exclude
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store
prune rust_engine/target
prune .git
